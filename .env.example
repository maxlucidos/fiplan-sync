# Configuração para testes no desenvolvimento, usada com --env:
#   "dist\FIPLAN Sync.exe" --simular --env .env
# Quem instala não usa este arquivo: o instalador pergunta tudo e grava criptografado.
# Copie para .env (que não vai para o repositório) e preencha.

ORACLE_USER=DETRAN_FIPLAN_USER
ORACLE_PASSWORD=
# Vazio = servidor padrão do FIPLAN (192.168.221.21, SID ormtp6)
ORACLE_CONNECT_STRING=

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

TABELA_VALIDACAO=sim
ATUALIZAR_NOTAS=nao
